<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TetherApp"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/cyber_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your tethering role"
        android:textSize="16sp"
        android:textColor="@color/cyber_text"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/role_host"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/role_client"/>

</LinearLayout>
